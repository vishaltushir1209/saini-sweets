# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real secrets.

# Random secret used to sign session JWTs. Generate one with:
#   npx auth secret
# or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The single admin account's login email.
ADMIN_EMAIL=admin@example.com

# Bcrypt hash of the admin's password — never store the plain password.
# Generate it by running:
#   node scripts/generate-admin-hash.mjs "your-chosen-password"
ADMIN_PASSWORD_HASH=
